      {
        "op": "submit",
        "intent": "blocked",
        "expect": {
          "result.accepted": false,
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "restart",
        "expect": {
          "local.account.halted": 1
        }
      },
      {
        "op": "reconcile",
        "resume": true,
        "expect": {
          "result.matched": true,
          "result.resumed": true,
          "local.orders.0.filled": 150,
          "local.account.cash": 850000,
          "local.position_qty": 150
