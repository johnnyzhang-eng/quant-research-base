[
  {
    "id": "E02",
    "title": "已收单而回复丢失：子进程退出77，再打开持久DB",
    "coverage": "stated reply-loss crash window",
    "steps": [
      {
        "op": "crash_submit",
        "expect": {
          "result.exit_code": 77,
          "local.orders.0.state": "SUBMITTING",
          "venue.accept_count": 1,
          "local.reserved_cash": 100500,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "restart",
        "expect": {
          "local.account.halted": 1,
          "local.orders.0.state": "UNKNOWN",
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "submit",
        "expect": {
          "result.duplicate": true,
          "result.state": "UNKNOWN",
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "submit",
        "intent": "blocked",
        "expect": {
          "result.accepted": false,
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "reconcile",
        "expect": {
          "result.matched": true,
          "result.resumed": false,
          "local.orders.0.state": "ACKNOWLEDGED",
          "local.account.halted": 1
        }
      },
      {
        "op": "reconcile",
        "resume": true,
        "expect": {
          "result.resumed": true,
          "local.account.halted": 0
        }
      },
      {
        "op": "submit",
        "expect": {
          "result.duplicate": true,
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "fill",
        "exec_id": "E2-F",
        "qty": 100,
        "fee": 500,
        "expect": {
          "local.account.cash": 899500,
          "local.position_qty": 100,
          "local.reserved_cash": 0
        }
      },
      {
        "op": "reconcile",
        "expect": {
          "result.matched": true,
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      }
    ],
    "gaps": []
  },
  {
    "id": "E04",
    "title": "撤单回报前又成交50：保留150份，释放余150份预留",
