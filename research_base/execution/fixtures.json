    "id": "E15",
    "title": "迟到费用/成交更正：隔离并暂停，尚未入账",
    "coverage": "quarantine only; NOT adjustment accounting",
    "steps": [
      {
        "op": "submit",
        "expect": {
          "result.accepted": true
        }
      },
      {
        "op": "fill",
        "exec_id": "adjust",
        "qty": 100,
        "fee": 500,
        "expect": {
          "local.account.cash": 899500
        }
      },
      {
        "op": "adjustment",
        "event": {
          "kind": "LATE_FEE",
          "fee_delta": 100,
          "exec_id": "adjust"
        },
        "expect": {
          "result.quarantined": true,
          "result.applied": false,
          "local.account.cash": 899500,
          "local.account.halted": 1
        }
      },
      {
        "op": "adjustment",
        "event": {
          "kind": "FILL_CORRECTION",
          "qty_delta": -10,
          "exec_id": "adjust"
        },
        "expect": {
          "result.quarantined": true,
          "local.account.cash": 899500,
          "local.position_qty": 100
        }
      },
      {
        "op": "restart",
        "expect": {
          "local.account.halted": 1
        }
      },
      {
        "op": "reconcile",
        "resume": true,
        "expect": {
          "result.resume_blocked": true,
          "local.account.halted": 1
        }
      }
    ],
    "gaps": [
