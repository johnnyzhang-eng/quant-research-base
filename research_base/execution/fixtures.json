    "title": "测试亏损阈值/人工暂停重启不自动恢复",
    "coverage": "bounded offline subset",
    "steps": [
      {
        "op": "submit",
        "expect": {
          "result.accepted": true
        }
      },
      {
        "op": "fill",
        "exec_id": "loss",
        "qty": 100,
        "fee": 500,
        "expect": {
          "local.account.cash": 899500
        }
      },
      {
        "op": "mark",
        "marks": {
          "TEST.CNY": "9.00"
        },
        "expect": {
          "result.loss": 10500,
          "result.paused": true
        }
      },
      {
        "op": "submit",
        "intent": "blocked",
        "expect": {
          "result.accepted": false,
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
        }
      },
      {
        "op": "restart",
        "expect": {
          "local.account.halted": 1,
          "local.account.reason": "TEST_LOSS_LIMIT"
        }
      },
      {
        "op": "reconcile",
        "resume": true,
        "expect": {
          "result.matched": true,
          "result.resumed": false,
          "result.resume_blocked": true,
          "local.account.halted": 1
        }
      },
      {
        "op": "pause",
        "reason": "MANUAL",
        "expect": {
          "local.account.reason": "MANUAL"
        }
      },
      {
        "op": "restart",
        "expect": {
          "local.account.reason": "MANUAL",
          "local.account.halted": 1
        }
      },
      {
        "op": "reconcile",
        "resume": true,
        "expect": {
          "result.resume_blocked": true,
          "local.account.halted": 1
        }
      }
    ],
    "gaps": [
      "合成估值，无真实净值/峰值回撤或管理员恢复流程。"
    ],
    "config": {
      "loss_limit": 10000
    }
  },
