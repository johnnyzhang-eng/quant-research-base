        "expect": {
          "local.orders.0.filled": 100,
          "local.reserved_cash": 200500,
          "local.account.cash": 900000
        }
      },
      {
        "op": "cancel",
        "expect": {
          "local.orders.0.state": "CANCEL_PENDING",
          "local.reserved_cash": 200500
