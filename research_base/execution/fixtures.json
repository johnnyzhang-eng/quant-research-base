  {
    "id": "E05",
    "title": "撤单超时/拒绝保持预留；之后到期释放",
    "coverage": "bounded offline subset",
    "steps": [
      {
        "op": "submit",
        "expect": {
          "local.reserved_cash": 100500
        }
      },
      {
        "op": "cancel",
        "expect": {
          "local.reserved_cash": 100500
        }
      },
      {
        "op": "cancel_response",
        "state": "TIMEOUT",
        "expect": {
          "result.accepted": false,
          "local.orders.0.state": "CANCEL_PENDING",
          "local.reserved_cash": 100500
        }
      },
      {
        "op": "cancel_response",
        "state": "CANCEL_REJECTED",
        "expect": {
          "result.reason": "CANCEL_REJECTED",
          "local.orders.0.state": "ACKNOWLEDGED",
          "local.reserved_cash": 100500
        }
      },
      {
        "op": "reconcile",
        "expect": {
          "result.matched": true,
          "local.reserved_cash": 100500
        }
      },
      {
        "op": "cancel_response",
        "state": "EXPIRED",
        "expect": {
          "local.orders.0.state": "EXPIRED",
          "local.reserved_cash": 0
        }
      },
      {
        "op": "reconcile",
        "expect": {
          "result.matched": true
        }
      }
    ],
    "gaps": [
      "无自主价格撮合或到期定时器；未成交与到期由事件控制。"
    ]
  },
  {
    "id": "E06",
    "title": "断线丢成交推送、乱序重放、重启补查",
