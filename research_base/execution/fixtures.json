          ],
          "local.account.halted": 1,
          "local.account.cash": 1000000,
          "local.position_qty": 0
        }
      },
      {
        "op": "external_order",
        "intent": "manual",
        "expect": {
          "venue.accept_count": 1,
          "venue.submit_call_count": 1
